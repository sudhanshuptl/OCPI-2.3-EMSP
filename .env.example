# Application Settings
APP_NAME=OCPI 2.3 eMSP Server
APP_VERSION=1.0.0
DEBUG=True

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/OCPI
DB_SCHEMA=OCPI_2_3
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# API Configuration
API_PREFIX=/api
